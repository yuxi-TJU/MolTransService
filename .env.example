# LLM provider can be "openai" or "gemini"
LLM_PROVIDER=openai

# API credentials (fill with your real key/URL)
LLM_API_KEY=your-api-key-here
LLM_API_URL=https://api.openai.com/v1/chat/completions

# Model selection for report generation (available: gpt5-nano, gpt5, gemini-2.5-pro)
# These settings have the HIGHEST priority
PARSE_MODEL=gpt5-nano
GEN_MODEL=gpt5-nano

# Optional default reports directory
REPORTS_DIR=./mol_trans_service/protocol_generator/report_database
OUTPUT_DIR=./generated_outputs
